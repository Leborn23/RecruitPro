# --- LLM Provider Settings ---
# Available Providers: 
#   - openai (Default)
#   - moonshot (Kimi)
#   - qwen (DashScope / AliCloud)
#   - deepseek
#   - doubao (Volcengine Ark)
#   - anthropic (Claude)
#   - gemini (Google)
#   - manual_openai (Any OpenAI-compatible server)

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Unified fallback credentials (recommended for quick switching providers)
# Priority: provider-specific key/base_url > API_KEY/BASE_URL > LLM_API_KEY/LLM_BASE_URL
API_KEY=
BASE_URL=
# Lowercase aliases are also supported
# api_key=
# base_url=
# Optional aliases (same behavior as API_KEY/BASE_URL)
# LLM_API_KEY=
# LLM_BASE_URL=

# API Keys (Configure only the ones you intend to use)
OPENAI_API_KEY=sk-xxxx
MOONSHOT_API_KEY=sk-xxxx
DASHSCOPE_API_KEY=sk-xxxx
DEEPSEEK_API_KEY=sk-xxxx
VOLCENGINE_API_KEY=xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx
GEMINI_API_KEY=xxxx

# Optional: Base URLs for compatible providers
OPENAI_BASE_URL=https://api.openai.com/v1
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
VOLCENGINE_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# --- Agent Environment ---
# AGENT_MODE: dev (with mock fallback), demo (fail-fast), prod (strict)
AGENT_MODE=dev
# Optional: allow dev mode to call real provider when key exists
# DEV_USE_REAL_LLM=false

# --- Interview Planning ---
# Total planned questions will be bounded by this inclusive range.
INTERVIEW_MIN_QUESTIONS=3
INTERVIEW_MAX_QUESTIONS=5

# --- Checkpoint Backend ---
# memory: in-process only, simplest for local dev
# sqlite: persists to a local SQLite file, survives process restarts on one host.
#         Current session locks are single-process only; keep AGENT_WORKER_COUNT=1
#         when using sqlite until a cross-process lock/backend is added.
AGENT_CHECKPOINT_BACKEND=memory
# Required when AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_SQLITE_PATH=artifacts/checkpoints/interview.sqlite
AGENT_WORKER_COUNT=1

# --- LangSmith Tracing ---
# Switch tracing on/off (recommended true for demo/prod validation)
LANGSMITH_TRACING=false

# Required when LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxx
LANGSMITH_PROJECT=hiregraph

# Optional workspace scoping (leave empty if not needed)
# LANGSMITH_WORKSPACE_ID=

# Privacy recommendations for resume/JD/interview sensitive data
# Set to true in production environments to avoid logging raw content.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# --- FastAPI Gateway ---
AGENT_SHARED_SECRET=replace-with-a-long-random-secret
AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=8000
